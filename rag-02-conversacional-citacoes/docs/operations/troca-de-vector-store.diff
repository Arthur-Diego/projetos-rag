composition root. Executado em 27/07/2026, com os dois containers no ar.

Pré-requisito:
    docker compose --profile experimento up -d chroma     # porta 8001 no host

--- a/composition.py
+++ b/composition.py
@@
-from rag.repository.vector_repository import QdrantVectorRepository, VectorRepository
+from rag.repository.chroma_vector_repository import ChromaVectorRepository
+from rag.repository.vector_repository import VectorRepository
@@ def build_repository(properties: RagProperties) -> VectorRepository:
-    return QdrantVectorRepository(
+    return ChromaVectorRepository(
         host=properties.qdrant_host,
-        port=properties.qdrant_port,
+        port=8001,
