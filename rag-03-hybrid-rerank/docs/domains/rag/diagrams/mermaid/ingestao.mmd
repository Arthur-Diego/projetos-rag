%% Fluxo de ingestao (FDD secao 4, fluxo de ingestao)
%% A ordem "conta, checa PDFs, destroi, cria com mapping explicito, le, grava" e fixa e testada:
%% falha depois da destruicao deixa o indice vazio, cujo sintoma e evidente,
%% e nunca desatualizado, cujo sintoma nao existe.
flowchart TD
    inicio(["ingest.py: IngestionFacade.ingest"])

    conta["1. Conta os trechos do índice anterior<br/>ANTES de destruir, para o relatório"]
    checaPdfs{"2. Existe PDF em pdfs/*.pdf?<br/>glob não recursivo"}
    semPdf["Encerra sem destruir o índice<br/>pdfs/fora-do-corpus/ nunca é indexado"]

    destroi["3. Destrói o índice existente"]
    cria["4. Cria o índice com MAPPING EXPLÍCITO<br/>campo dense_vector com a dimensão declarada<br/>campo de texto analisado, analisador em português<br/>o mapping nasce no código e NUNCA é inferido pelo motor"]

    le["5. DocumentReader lê as páginas<br/>numa passada, páginas 1-based e contagem de descartes"]
    divide["6. ChunkingService divide as páginas em trechos"]
    embeda["7. Embeda os trechos<br/>API de embeddings da OpenAI"]
    grava["8. Grava um documento por chunk<br/>mesmo documento carrega vetor, texto analisado, fonte e página"]

    relatorio["Relatório de ingestão<br/>páginas, descartes, trechos, trechos do índice anterior,<br/>parâmetros de divisão e tempo"]
    fim(["Índice pronto para os dois caminhos de busca"])

    inicio --> conta
    conta --> checaPdfs
    checaPdfs -. "não" .-> semPdf
    checaPdfs -- "sim" --> destroi
    destroi --> cria
    cria --> le
    le --> divide
    divide --> embeda
    embeda --> grava
    grava --> relatorio
    relatorio --> fim

    alerta["Risco mais sério do projeto:<br/>mapping inferido faz o BM25 degradar em silêncio.<br/>Sem mapping explícito, metade do funil para de funcionar sem erro nenhum."]
    cria -.-> alerta

    classDef critico fill:#fff3bf,stroke:#bf8700,stroke-width:3px,color:#111
    classDef passo fill:#e8f4ff,stroke:#1f6feb,stroke-width:2px,color:#111
    classDef desvio fill:#f6f8fa,stroke:#8b949e,stroke-dasharray: 4 4,color:#111
    classDef nota fill:#ffe9e9,stroke:#cf222e,stroke-dasharray: 4 4,color:#111

    class cria critico
    class conta,destroi,le,divide,embeda,grava,relatorio passo
    class semPdf desvio
    class alerta nota
