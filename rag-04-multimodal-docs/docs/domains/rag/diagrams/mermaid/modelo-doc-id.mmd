%% Modelo de dados do multi-vector: 1 elemento -> 1 original -> N representacoes
%% Fontes: HLD v1.0, secao "Modelo de dados (alto nivel)"; FDD secoes 4 e 5; ADRs 001 a 003.
%% O N e DELIBERADO e ja esta no esquema: a v1 grava UMA representacao por original, mas
%% multi-representacao (perguntas hipoteticas do exercicio 2, tabela crua alem do resumo)
%% entra sem migracao. E tambem o plano de contingencia do risco 3, o resumo que nao casa
%% com as perguntas reais.
%% DocumentElement existe APENAS durante a ingestao: nao e persistido em armazem nenhum.
erDiagram
    DocumentElement ||--|| StoredOriginal : "vira exatamente um original"
    StoredOriginal ||--o{ IndexedRepresentation : "é indexado como N representações, sob o mesmo doc_id"

    DocumentElement {
        string categoria "texto, tabela ou imagem, vindo da partição hi_res"
        int page "página 1-based no PDF"
        string source "nome do arquivo em pdfs/"
        string conteudo "texto agrupado, HTML da tabela ou caminho da figura"
    }

    StoredOriginal {
        string doc_id PK "hash de conteúdo mais origem mais tipo, determinístico (ADR-003)"
        string kind "texto, tabela ou imagem"
        string conteudo "ÍNTEGRO: texto cru, HTML completo ou caminho em data/figures/"
        int page "vale para os três kinds"
        string source "PDF de origem"
        string armazem "LocalFileStore em data/docstore/, a fonte de verdade"
    }

    IndexedRepresentation {
        string doc_id FK "metadado que resolve o original, única ligação entre os armazéns"
        string representacao "texto direto, resumo da tabela ou descrição da imagem (ADR-002)"
        vector embedding "text-embedding-3-small, sobre a representação e nunca sobre o original"
        string kind "repetido no metadado para filtro e para o selo do frontend"
        int page "repetido no metadado, vira SearchHit.page"
        string armazem "Chroma em container na porta 8002, índice derivado"
    }
